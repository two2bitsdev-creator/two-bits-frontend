# Public site metadata (used for SEO + footer/contact copy).
NEXT_PUBLIC_SITE_URL=https://two-bits.dev
NEXT_PUBLIC_CONTACT_EMAIL=hello@two-bits.dev

# Default theme applied before the visitor has a stored preference.
# One of: light | dark
NEXT_PUBLIC_DEFAULT_THEME=light

# Motion profile for background effects (matrix rain, timings).
# showpiece = full animation intensity, calm = reduced motion / slower.
NEXT_PUBLIC_MOTION=showpiece

# Number of "matrix rain" columns rendered in the hero background (0-24).
NEXT_PUBLIC_RAIN_DENSITY=14

# Optional: wire the contact form to a real backend later.
# CONTACT_FORM_ENDPOINT=
# RESEND_API_KEY=
